{
  "name": "@andromedaprotocol/cli",
  "version": "2.0.0-beta.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andromedaprotocol/andromeda-cli.git"
  },
  "description": "",
  "main": "./dist/index.js",
  "bin": {
    "andr": "dist/cli.js"
  },
  "scripts": {
    "start": "ANDR_CONFIG_DIR='./.andr-cli-test' nodemon --exec \"npm run\" dev",
    "start:windows": "nodemon --exec \"npm run\" build",
    "create": "npm run build && npm run test",
    "build": "rimraf ./dist && tsc -p tsconfig.build.json && tsc-alias tsc -p tsconfig.build.json",
    "install:local": "ts-node ./scripts/install.ts",
    "uninstall:local": "ts-node ./scripts/uninstall.ts",
    "test": "jest",
    "tsc": "tsc -p tsconfig.json --noEmit",
    "depcheck": "depcheck",
    "dev": "ANDR_CONFIG_DIR='./.andr-cli-test' ts-node-dev -r tsconfig-paths/register src/cli.ts",
    "list-global": "npm --global ls"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "files": [
    "dist/**/*"
  ],
  "dependencies": {
    "@andromedaprotocol/andromeda.js": "workspace:*",
    "@cosmjs/amino": "^0.32.4",
    "@cosmjs/crypto": "^0.32.4",
    "@cosmjs/proto-signing": "^0.32.4",
    "@cosmjs/stargate": "^0.32.4",
    "axios": "^1.7.7",
    "cli-spinner": "^0.2.10",
    "cli-table": "^0.3.11",
    "convict": "^6.2.4",
    "convict-format-with-validator": "^6.2.0",
    "crypto-js": "^4.2.0",
    "figlet": "^1.7.0",
    "gradient-string": "^2.0.2",
    "inquirer": "8.2.4",
    "inquirer-autocomplete-prompt": "^2.0.1",
    "inquirer-command-prompt": "^0.1.0",
    "inquirer-interrupted-prompt": "^2.0.1",
    "jsonschema": "^1.4.1",
    "keytar": "^7.9.0",
    "lodash": "^4.17.21",
    "minimist": "^1.2.8",
    "picocolors": "^1.1.0"
  },
  "devDependencies": {
    "@types/async": "^3.2.24",
    "@types/cli-spinner": "^0.2.3",
    "@types/cli-table": "^0.3.4",
    "@types/convict": "^6.1.6",
    "@types/convict-format-with-validator": "^6.0.5",
    "@types/crypto-js": "^4.2.2",
    "@types/figlet": "^1.5.8",
    "@types/gradient-string": "^1.1.6",
    "@types/inquirer": "^8.2.10",
    "@types/inquirer-autocomplete-prompt": "^2.0.2",
    "@types/jest": "^29.5.12",
    "@types/lodash": "^4.17.7",
    "@types/minimist": "^1.2.5",
    "@types/node": "^18.19.50",
    "async": "^3.2.6",
    "depcheck": "^1.4.7",
    "jest": "^29.7.0",
    "nodemon": "^2.0.22",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.4"
  },
  "pnpm": {
    "overrides": {
      "braces@<3.0.3": ">=3.0.3",
      "ws@>=7.0.0 <7.5.10": ">=7.5.10",
      "micromatch@<4.0.8": ">=4.0.8"
    }
  }
