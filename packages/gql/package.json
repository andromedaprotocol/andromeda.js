{
  "name": "@andromedaprotocol/gql",
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andromedaprotocol/andromeda-cli.git"
  },
  "description": "",
  "main": "./dist/index.js",
  "scripts": {
    "build": "rimraf ./dist && npm run codegen && tsc && tsc-alias",
    "build:plugin": "rimraf ./plugins/dist && tsc -p tsconfig.plugin.json && tsc-alias -p tsconfig.plugin.json",
    "tsc": "tsc --noEmit",
    "depcheck": "depcheck",
    "codegen:master": "npm run build:plugin && graphql-codegen --config codegen.master.ts",
    "codegen:build": "rimraf ./__generated && graphql-codegen --config codegen.build.ts",
    "codegen": "npm run codegen:master && npm run codegen:build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "files": [
    "dist/**/*"
  ],
  "dependencies": {
    "@apollo/client": "^3.11.8",
    "graphql": "^16.9.0",
    "graphql-request": "^6.1.0",
    "graphql-tag": "^2.12.6"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "5.0.0",
    "@graphql-codegen/core": "^4.0.2",
    "@graphql-codegen/plugin-helpers": "^5.0.4",
    "@graphql-codegen/schema-ast": "^4.1.0",
    "@graphql-codegen/typescript": "^4.0.9",
    "@graphql-codegen/typescript-apollo-client-helpers": "^2.2.6",
    "@graphql-codegen/typescript-graphql-request": "^5.0.0",
    "@graphql-codegen/typescript-operations": "^4.2.3",
    "@graphql-codegen/typescript-react-apollo": "^3.3.7",
    "@graphql-codegen/visitor-plugin-common": "^4.1.2",
    "@graphql-tools/utils": "^10.5.4",
    "@types/node": "^18.19.50",
    "depcheck": "^1.4.7",
    "tsc-alias": "^1.8.10",
    "typescript": "^5.5.4"
  },
  "pnpm": {
    "overrides": {
      "braces@<3.0.3": ">=3.0.3",
      "ws@>=7.0.0 <7.5.10": ">=7.5.10",
      "micromatch@<4.0.8": ">=4.0.8"
    }
  }
}